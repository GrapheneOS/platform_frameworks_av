<?xml version="1.0" encoding="utf-8"?>
<configuration description="MicSpoofing Tests configuration">
    <option name="test-tag" value="MicSpoofingTests" />

    <target_preparer class="com.android.tradefed.targetprep.suite.SuiteApkInstaller">
        <option name="cleanup-apks" value="true" />
        <option name="test-file-name" value="MicSpoofingTests.apk" />
    </target_preparer>

    <target_preparer class="com.android.tradefed.targetprep.RootTargetPreparer">
        <option name="force-root" value="true" />
    </target_preparer>

    <target_preparer class="com.android.tradefed.targetprep.PushFilePreparer">
        <option name="cleanup" value="true" />
        <option name="push-file" key="spoofed_mic_audio_test.wav"
            value="/data/local/tmp/mic_spoofing_test.wav" />
    </target_preparer>

    <target_preparer class="com.android.tradefed.targetprep.RunCommandTargetPreparer">
        <option name="run-command"
            value="setprop debug.mic_spoofing.default_audio_path /data/local/tmp/mic_spoofing_test.wav" />
        <option name="teardown-command"
            value='setprop debug.mic_spoofing.default_audio_path &quot;&quot;' />
    </target_preparer>

    <target_preparer class="com.android.tradefed.targetprep.RunCommandTargetPreparer">
        <option name="run-command"
            value="mkdir -p /data/media/0" />
        <option name="run-command"
            value="cp /data/local/tmp/mic_spoofing_test.wav /data/media/0/mic_spoofing_test.wav" />
        <option name="run-command"
            value="chmod 644 /data/media/0/mic_spoofing_test.wav" />
        <option name="run-command"
            value="restorecon /data/media/0/mic_spoofing_test.wav" />
        <option name="teardown-command"
            value="rm -f /data/media/0/mic_spoofing_test.wav" />
    </target_preparer>

    <!-- Revoke RECORD_AUDIO after install, before the test process starts -->
    <target_preparer class="com.android.tradefed.targetprep.RunCommandTargetPreparer">
        <option name="run-command"
            value="pm revoke com.android.mic_spoofing_test android.permission.RECORD_AUDIO" />
    </target_preparer>

    <test class="com.android.tradefed.testtype.AndroidJUnitTest">
        <option name="package" value="com.android.mic_spoofing_test" />
        <option name="runner" value="androidx.test.runner.AndroidJUnitRunner" />
    </test>
</configuration>
