package {
    default_applicable_licenses: ["frameworks_av_media_libmedia_license"],
}

cc_test {
    name: "IMediaRecorderTest",
    test_suites: ["device-tests", "mts"],
    gtest: true,

    srcs: [
        "IMediaRecorderTest.cpp",
    ],

    shared_libs: [
        "libbase",
        "libbinder",
        "liblog",
        "libmedia",
        "libutils",
    ],

    compile_multilib: "first",

    cflags: [
        "-Werror",
        "-Wall",
    ],
}
